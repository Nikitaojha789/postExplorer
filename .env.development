# development — PUBLIC build configuration. Never put secrets here: every value is
# readable from the shipped binary. Personal overrides go in .env.local (ignored).
APP_ENV=development
APP_DISPLAY_NAME=Baseline Dev
APP_ID_SUFFIX=.dev
API_URL=https://jsonplaceholder.typicode.com
API_TIMEOUT_MS=15000
DEEP_LINK_SCHEME=baseline-dev
DEEP_LINK_HOST=app.example.com
SENTRY_DSN=
USE_MOCK_API=false

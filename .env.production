# production — PUBLIC build configuration. Never put secrets here: every value is
# readable from the shipped binary. Personal overrides go in .env.local (ignored).
APP_ENV=production
APP_DISPLAY_NAME=Baseline
APP_ID_SUFFIX=
API_URL=https://jsonplaceholder.typicode.com
API_TIMEOUT_MS=15000
DEEP_LINK_SCHEME=baseline
DEEP_LINK_HOST=app.example.com
SENTRY_DSN=
USE_MOCK_API=false

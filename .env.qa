# qa — PUBLIC build configuration. Never put secrets here: every value is
# readable from the shipped binary. Personal overrides go in .env.local (ignored).
APP_ENV=qa
APP_DISPLAY_NAME=Baseline QA
APP_ID_SUFFIX=.qa
API_URL=https://api.qa.example.com
API_TIMEOUT_MS=15000
DEEP_LINK_SCHEME=baseline-qa
DEEP_LINK_HOST=app.example.com
SENTRY_DSN=
USE_MOCK_API=false

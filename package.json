{
  "name": "baseline",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "android": "npm run android:dev",
    "android:dev": "react-native run-android --mode devDebug --appIdSuffix dev",
    "android:qa": "react-native run-android --mode qaRelease --appIdSuffix qa",
    "android:staging": "react-native run-android --mode stagingRelease --appIdSuffix staging",
    "android:prod": "react-native run-android --mode prodRelease",
    "ios": "npm run ios:dev",
    "ios:dev": "react-native run-ios --scheme Baseline-Dev --mode Debug-Dev",
    "ios:qa": "react-native run-ios --scheme Baseline-QA --mode Release-QA",
    "ios:staging": "react-native run-ios --scheme Baseline-Staging --mode Release-Staging",
    "ios:prod": "react-native run-ios --scheme Baseline-Prod --mode Release-Prod",
    "pods": "cd ios && bundle exec pod install",
    "pods:update": "cd ios && bundle exec pod update",
    "build:android": "cd android && ./gradlew bundleProdRelease",
    "build:android:apk": "cd android && ./gradlew assembleProdRelease",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:perf": "reassure",
    "test:perf:baseline": "reassure --baseline",
    "e2e": "maestro test .maestro",
    "i18n:check": "node scripts/check-i18n.mjs",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run i18n:check && npm run test",
    "clean": "node scripts/clean.mjs",
    "ios:configure": "cd ios && bundle exec ruby ../scripts/ios-configure-project.rb"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "8.13.0",
    "@formatjs/intl-getcanonicallocales": "^3.2.12",
    "@formatjs/intl-locale": "^5.3.12",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/elements": "^2.9.44",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@sentry/react-native": "8.28.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/query-async-storage-persister": "^5.104.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-persist-client": "^5.104.0",
    "expo": "^58.0.17",
    "i18next": "^26.4.2",
    "react": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.88.0",
    "react-native-bootsplash": "^6.3.10",
    "react-native-config": "1.7.2",
    "react-native-device-info": "15.0.2",
    "react-native-gesture-handler": "3.4.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-keychain": "10.0.0",
    "react-native-localize": "3.7.2",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-permissions": "5.6.2",
    "react-native-reanimated": "4.7.1",
    "react-native-restart": "0.0.29",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-plugin": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "jest": "~30.5.2",
    "lefthook": "^2.1.15",
    "prettier": "^3.9.9",
    "reassure": "^1.6.0",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": "^22.22.0 || >=24.3.0"
  },
  "allowScripts": {
    "lefthook@2.1.15": true,
    "@sentry/cli@2.58.6": true,
    "@sentry/cli@3.8.0": true,
    "unrs-resolver@1.12.2": true
  }
}
